{
  "name": "dashboard-camaronera-backend",
  "version": "1.0.0",
  "description": "API Express para Dashboard Gerencial de Producción Camaronera (SQL Server)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:prod": "node dist/database/migrate.js",
    "telegram:dev": "tsx src/telegram/main.ts",
    "telegram:start": "node dist/telegram/main.js",
    "test:telegram": "npm run build && node --test tests/telegram*.test.cjs",
    "test:telegram:ai": "npm run build && TELEGRAM_TEST_AI=true node --test tests/telegram-reader.live.cjs",
    "test:telegram:sql": "npm run build && AUTH_DB_DATABASE=DashboardGerencialAuth_Telegram_QA node --test --test-concurrency=1 tests/telegram-store.test.cjs tests/telegram-http.test.cjs tests/telegram-lease.test.cjs",
    "test:recepcion": "npm run build && node --test tests/recepcion.test.cjs",
    "test:cargas": "npm run build && node --test tests/preload.test.cjs tests/load-report.test.cjs tests/load-edit.test.cjs",
    "test:inventario-fresco": "npm run build && node --test tests/fresh-inventory.test.cjs"
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.0",
    "@napi-rs/canvas": "^0.1.80",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "mssql": "^11.0.1",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "redis": "^5.12.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.7",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5"
  }
}
