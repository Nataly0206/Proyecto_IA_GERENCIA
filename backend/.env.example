# Servidor API
NODE_ENV=development
PORT=3002
# Dejar vacío en producción si el frontend llega por el mismo origen
# (proxy nginx). Solo listar orígenes explícitos separados por coma si
# hay un frontend en otro dominio.
CORS_ORIGIN=http://localhost:5173
# Obligatoria en producción (el servidor no arranca sin ella si
# NODE_ENV=production). El frontend debe enviarla como header X-API-Key
# (ver VITE_API_KEY en frontend/.env.example). Generar con:
# openssl rand -hex 32
API_KEY=

# SQL Server
# IMPORTANTE: usar un login de SOLO LECTURA dedicado (NUNCA "sa" ni un
# usuario con roles de sysadmin/db_owner). Ver backend/sql/create_readonly_user.sql
# para crear un login con permiso SELECT únicamente sobre las vistas AV_*
# que necesita el dashboard y el asistente IA.
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=NombreBaseDatos
DB_USER=usuario_solo_lectura
DB_PASSWORD=contraseña
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Asistente IA (NVIDIA API Catalog / API compatible con OpenAI)
NVIDIA_API_KEY=nvapi-tu-api-key
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# Opcional. En Docker se configura automáticamente.
AI_CONTEXT_PATH=
# Acceso único al dashboard. Use una contraseña larga y distinta a las de BD.
LOGIN_PASSWORD=cambie-esta-contrasena
# Secreto aleatorio de al menos 32 caracteres para firmar sesiones.
# Puede generarlo con: openssl rand -hex 32
SESSION_SECRET=cambie-por-un-valor-aleatorio-de-64-caracteres
SESSION_HOURS=12
# Active únicamente cuando el dashboard se publique mediante HTTPS.
COOKIE_SECURE=false
