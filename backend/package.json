{
  "name": "dashboard-camaronera-backend",
  "version": "1.0.0",
  "description": "API Express para Dashboard Gerencial de Producción Camaronera (SQL Server)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:prod": "node dist/database/migrate.js"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "mssql": "^11.0.1",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5"
  }
}
